#!/bin/bash
# LearningHub Pre-Commit Hook
# Runs quick audit to catch CRITICAL issues before commit.
# Configure: git config core.hooksPath .githooks

echo "Running LearningHub quick audit..."

# Run quick audit (CRITICALs only)
python tools/site_audit.py --quick

if [ $? -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: CRITICAL issues found!"
    echo "Fix the issues above, then try again."
    echo "To skip (not recommended): git commit --no-verify"
    exit 1
fi

echo "Audit passed - no CRITICAL issues found."
exit 0
